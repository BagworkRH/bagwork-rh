# Frontend environment (local)
#
# The API host matters for OAuth: the provider's redirect_uri is built from the
# request's Host header and must match a callback registered with the provider
# *exactly*, so keep this identical to X_REDIRECT_URI's host in backend/.env
# (127.0.0.1 and localhost are different values to X).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001