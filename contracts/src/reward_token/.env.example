# ==========================================================================
# bagworkRH contracts - environment configuration
# Copy to `.env` (never commit it; `.env` is gitignored).
# Loaded automatically by hardhat.config.ts via `dotenv/config`.
# ==========================================================================

# Deployer / signer. Generate a FRESH, dedicated key for this:
#   node -e "const {Wallet}=require('ethers');const w=Wallet.createRandom();console.log(w.address, w.privateKey)"
# Testnet only. Never reuse a key that has touched mainnet, and never commit this.
DEPLOYER_PRIVATE_KEY=

# The token the distributor pays creators in.
# LEAVE BLANK to deploy the development RewardToken and pay in it (local/dev only).
# SET to an existing ERC-20 (the testnet USDG address Paxos provides) to pay
# creators in the stablecoin brands fund with. When set, the distributor is wired
# to this address and no RewardToken is deployed; the script reads its symbol and
# decimals and prints the TokenConfig row the backend must register.
# USDG is 6 decimals — register it with those decimals, not the platform default.
PAYOUT_TOKEN_ADDRESS=

# Escrow funding (scripts/fund-escrow.ts). The distributor pays claims from its
# own escrow, so the owner must approve + deposit the payout token first.
#   DISTRIBUTOR_ADDRESS: the deployed RewardDistributor (printed by deploy.ts)
#   ESCROW_DEPOSIT:      a whole-token amount, e.g. "50" = 50 USDG
DISTRIBUTOR_ADDRESS=
ESCROW_DEPOSIT=

# Where the 15% platform fee accrues. DEFAULT IS THE DEPLOYER, which is fine on
# testnet but WRONG for production: set this to a multisig so a compromised
# deployer key cannot also control the fee money.
TREASURY_ADDRESS=

# Must match keccak256("<name>") in contracts/RewardDistributor.sol and
# DOMAIN_NAME in backend/apps/blockchain/signing.py. The deploy script refuses
# to run on a mismatch, because a deployed contract's DOMAIN_SEPARATOR can never
# be repaired -- a divergence means redeploying.
EIP712_DOMAIN_NAME=bagworkRH

# RPC overrides. The public endpoints below are rate-limited and not for
# production; use Alchemy/QuickNode and set these.
#   testnet: chain id 46630   mainnet: chain id 4663
RH_RPC_URL_TESTNET=https://rpc.testnet.chain.robinhood.com
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Testnet ETH (gas) is free from the official faucet:
#   https://faucet.testnet.chain.robinhood.com
