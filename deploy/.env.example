# ==========================================================================
# bagworkRH — production environment (docker compose).
#
#   cp .env.example .env      # then fill in every blank below
#
# This file is read by docker-compose AND mounted into the backend containers,
# so it is the single source of production configuration. NEVER commit it.
#
# Generate the three secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ==========================================================================

# Compose-level: the hostname nginx answers on, and the public URL baked into
# the Next.js client bundle at build time. Both must match the DNS record.
DOMAIN=bagworkrh.com
PUBLIC_URL=https://bagworkrh.com

# Django -------------------------------------------------------------------
DEBUG=0
SECRET_KEY=
ALLOWED_HOSTS=bagworkrh.com,www.bagworkrh.com
CSRF_TRUSTED_ORIGINS=https://bagworkrh.com,https://www.bagworkrh.com
# Empty on purpose: the site and the API share one domain, so nothing is
# cross-origin and there is no CORS policy to get wrong.
CORS_ALLOWED_ORIGINS=

# Database (the `db` service from docker-compose.yml) ----------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bagworkrh
DB_USER=bagworkrh
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Redis / Celery (the `redis` service) -------------------------------------
REDIS_URL=redis://redis:6379/0

# Social providers ---------------------------------------------------------
SOCIAL_PROVIDER_MODE=official
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the X app's callback EXACTLY, and be registered there.
X_REDIRECT_URI=https://bagworkrh.com/api/v1/x/x/callback/
# Encrypts stored OAuth tokens. Set it BEFORE the first connect and never
# change it afterwards without running `manage.py rotate_social_credentials`.
SOCIAL_ENCRYPTION_KEY=
SOCIAL_OAUTH_STATE_TTL_SECONDS=600

# Where the browser is sent back to after an OAuth callback.
FRONTEND_URL=https://bagworkrh.com

# Blockchain (Robinhood Chain) --------------------------------------------
# Use a paid RPC provider here: the public endpoints are rate-limited, and this
# process polls the chain continuously, so limits show up as missed events.
RPC_URL=
CHAIN_ID=46630
REWARD_TOKEN_ADDRESS=
CONTRACT_ADDRESS=
CLAIM_SIGNER=
CLAIM_SIGNER_ADDRESS=
TOKEN_DECIMALS=18
EIP712_DOMAIN_NAME=bagworkRH

# Brand funding rail -------------------------------------------------------
FUNDING_TREASURY_ADDRESS=
FUNDING_CONFIRMATIONS=3
FUNDING_TOKEN_SYMBOL=USDG
# Signs movements OUT of the treasury. Deliberately NOT the deployer or claim
# signer key: compromising one must not hand over the others.
TREASURY_PRIVATE_KEY=

# Operations ---------------------------------------------------------------
ENVIRONMENT=production
# One JSON object per line, so a log pipeline can parse it.
LOG_FORMAT=json
HEARTBEAT_STALE_SECONDS=300
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RISK_REVIEW_THRESHOLD=30

# Rate limiting (leave as-is unless you have measured a reason to change).
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_AUTH=10/hour
THROTTLE_ADMIN=120/hour
THROTTLE_WALLET=30/hour
THROTTLE_SUBMIT=20/hour
