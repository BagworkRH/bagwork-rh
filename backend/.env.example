# ==========================================================================
# bagworkRH - environment configuration
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# ==========================================================================

# Django
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bagwork_rh
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Social platform providers (Stage 2: real API testing).
# `official` uses each platform's real API; `mock` uses the clearly-marked
# DEVELOPMENT mock for every platform. See docs/09_Testing_Real_Social_APIs.md.
SOCIAL_PROVIDER_MODE=mock
# Legacy X-only switch, kept working. Only consulted when SOCIAL_PROVIDER_MODE
# is unset. Prefer SOCIAL_PROVIDER_MODE.
X_PROVIDER=official

# X (Twitter) — console.x.com -> project -> Keys and tokens -> OAuth 2.0
# Scopes used: tweet.read, users.read
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/x/callback/

# TikTok — developers.tiktok.com. `video.list` requires an approved app.
# Scopes used: user.info.basic, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/tiktok/callback/

# Frontend
FRONTEND_URL=http://localhost:3000

# Blockchain (Phase 6)
# Robinhood Chain (Arbitrum L2 on Ethereum) is the launch chain.
#   testnet: CHAIN_ID=46630  https://rpc.testnet.chain.robinhood.com
#   mainnet: CHAIN_ID=4663   https://rpc.mainnet.chain.robinhood.com
# Public endpoints are rate-limited; use a provider (Alchemy/QuickNode) in prod.
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
REWARD_TOKEN_ADDRESS=
CONTRACT_ADDRESS=
# Testnet-only development signer key. NEVER use a production key here.
CLAIM_SIGNER=
CLAIM_SIGNER_ADDRESS=
TOKEN_DECIMALS=18

# Fraud/risk review queue (Phase 7). Signals that score at or above this
# threshold are queued for human review; nothing is actioned automatically.
RISK_REVIEW_THRESHOLD=30

# Rate limiting (Phase 8). Rates follow DRF "N/period" syntax. Dev settings
# default these to 100000/hour so the test-suite never trips them.
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_AUTH=10/hour
THROTTLE_ADMIN=120/hour
THROTTLE_WALLET=30/hour
# Post submission leads to a payout, so it is limited far below the general
# user rate (1000/hour). The Celery discovery path does not use this endpoint.
THROTTLE_SUBMIT=20/hour

# Monitoring / error tracking (Phase 8). Sentry stays a no-op when empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
ENVIRONMENT=development
# Heartbeat freshness threshold reported by /api/health/ (seconds).
HEARTBEAT_STALE_SECONDS=300