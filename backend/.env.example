# ==========================================================================
# Crypto Social Rewards Platform - environment configuration
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# ==========================================================================

# Django
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=crypto_rewards
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# X (Twitter) API credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/x/callback/
# Set to `mock` for the clearly-marked DEVELOPMENT mock provider,
# `official` for the real X API.
X_PROVIDER=official

# Frontend
FRONTEND_URL=http://localhost:3000

# Blockchain (Phase 6)
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111
REWARD_TOKEN_ADDRESS=
CONTRACT_ADDRESS=
# Testnet-only development signer key. NEVER use a production key here.
CLAIM_SIGNER=
CLAIM_SIGNER_ADDRESS=
TOKEN_DECIMALS=18